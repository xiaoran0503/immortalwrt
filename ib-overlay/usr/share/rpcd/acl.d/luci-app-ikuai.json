{
	"luci-app-ikuai": {
		"description": "Read system/network state for the calm overview dashboard",
		"read": {
			"ubus": {
				"system": [ "info", "board" ],
				"network.interface": [ "dump", "status" ],
				"service": [ "list" ],
				"luci": [ "getDHCPLeases" ],
				"file": [ "read" ]
			},
			"uci": [ "*" ],
			"file": {
				"/proc/net/arp": [ "read" ],
				"/tmp/dhcp.leases": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"uci": [ "set", "commit", "apply" ]
			},
			"uci": [ "*" ]
		}
	}
}
